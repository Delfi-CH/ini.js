{
  "name": "@delfi-ch/ini.js",
  "version": "0.9.9",
  "description": "Key-Value Parser for JavaScript",
  "keywords": [
    "ini",
    "key-value",
    "kv",
    "parser"
  ],
  "license": "BSD-2-Clause",
  "author": "Delfi-CH <delfi@delfi.dev> (https://delfi.dev)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "import": "./dist/fs.js",
      "require": "./dist/fs.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "tsx test/test.ts",
    "t2": "tsx test/test2.ts",
    "build": "esbuild src/index.ts --bundle --minify --outfile=dist/index.js && esbuild src/fs.ts --bundle --minify --platform=neutral --packages=external --outfile=dist/fs.js && esbuild src/index.ts --bundle --minify --platform=node --outfile=dist/index.cjs && esbuild src/fs.ts --bundle --minify --platform=node --outfile=dist/fs.cjs && tsc",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Delfi-CH/ini.js.git"
  },
  "bugs": {
    "url": "https://github.com/Delfi-CH/ini.js/issues"
  },
  "homepage": "https://github.com/Delfi-CH/ini.js",
  "readme": "README.md",
  "devDependencies": {
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
